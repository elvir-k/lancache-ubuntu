## LanCache settings. install.sh creates .env from these for you.
## Edit .env and run: sudo docker compose up -d   to apply changes.

## Keep true when using the single "monolithic" cache container (default)
USE_GENERIC_CACHE=true

## IP of this server on the gaming center LAN. Game downloads are sent here.
LANCACHE_IP=192.168.1.10

## IP the DNS server listens on (normally the same as LANCACHE_IP)
DNS_BIND_IP=192.168.1.10

## DNS servers used for everything that is not cached. Separate several with ";"
UPSTREAM_DNS=1.1.1.1; 1.0.0.1

## Where cached games are stored. Use a large disk, ideally a dedicated one.
CACHE_ROOT=/srv/lancache

## Maximum cache size. Oldest unused content is removed when it gets full.
CACHE_DISK_SIZE=1000g

## Free space that must always stay available on the cache disk
MIN_FREE_DISK=20g

## Index memory: about 250m per 1000g of cache
CACHE_INDEX_SIZE=250m

## How long cached content is kept
CACHE_MAX_AGE=3650d

## Timezone for log timestamps
TZ=Europe/Belgrade
